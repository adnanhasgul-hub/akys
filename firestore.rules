rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }
    // No data model or public share exception exists yet.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
